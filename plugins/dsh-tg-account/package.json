{
  "name": "@local/dsh-tg-account",
  "version": "0.10.6",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "description": "DSH 输入框账目胶囊：按 provider:model 计价的本会话花费（含子代理子树归并与超预算告警）、换会话提醒、逐轮明细、输出瘦身开关、一键切会话（预填交接卡）、链级自动切换（轮末判定、Enter 转接，链内开关一致）、侧栏母会话色标与聚合排序。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "token",
    "cost",
    "handoff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
