# 本地配置（含本机路径，不要提交）
config.yaml

# 历史备份
_history/
*.bak
*.bak-*
*.bak-tokenclean-*

# 本地挂载（打包/发布时不应带）
skills/*/docs

# 插件依赖（npm/pnpm 装出来的目录不发布）
plugins/*/node_modules/

# 运行产物
__pycache__/
*.pyc
reports/
tmp/
# ledger.py 派生出的本机账本与解析缓存（含会话 ID / 标题，不要提交）
data/ledger.json
data/ledger.json.cache.json
# prices export 派生的价表快照（源自未提交的 config.yaml；别提交，否则换机会读到别人的价）
data/prices.json
# baseline.py --write 的本机基线（doctor --apply 会生成）
tg-baseline.json

# 宣传物 QA 产物
promo/preview*/
promo/checks.json

# 本机私有资料（不发布）
_local/

# 锻造草稿（round-* 脚本、state.json、样本卡，含本机路径）
_forge/
